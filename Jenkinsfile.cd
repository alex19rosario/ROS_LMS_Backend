pipeline {
    agent any
    environment {
        AWS_DEFAULT_REGION = "us-east-1"
        APPLICATION_NAME = "Ros-lms-backend" // Your EB application name
        ENVIRONMENT_NAME = "Ros-lms-backend-env" // Your EB environment name
        S3_BUCKET = "your-deployment-bucket" // S3 bucket for deployment artifacts
        JAR_FILE = "target/your-application.jar" // Path to your built JAR
    }
    stages {
        stage('Build') {
            steps {
                sh './mvnw clean package -DskipTests'
            }
        }

        stage('Upload JAR to S3') {
            steps {
                withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'aws-credentials', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                    script {
                        def timestamp = new Date().format('yyyyMMddHHmmss')
                        def versionLabel = "app-${timestamp}"
                        env.VERSION_LABEL = versionLabel

                        sh """
                            aws s3 cp ${JAR_FILE} s3://${S3_BUCKET}/${versionLabel}.jar
                        """
                    }
                }
            }
        }

        stage('Deploy to Elastic Beanstalk') {
            steps {
                withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'aws-credentials', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                    sh """
                        # 1. Create version
                        aws elasticbeanstalk create-application-version \
                            --application-name ${APPLICATION_NAME} \
                            --version-label ${VERSION_LABEL} \
                            --source-bundle S3Bucket="${S3_BUCKET}",S3Key="${VERSION_LABEL}.jar"

                        # 2. Deploy
                        aws elasticbeanstalk update-environment \
                            --application-name ${APPLICATION_NAME} \
                            --environment-name ${ENVIRONMENT_NAME} \
                            --version-label ${VERSION_LABEL}

                        # 3. Wait for deployment to complete
                        echo "Waiting for deployment to finish..."
                        aws elasticbeanstalk wait environment-updated \
                            --application-name ${APPLICATION_NAME} \
                            --environment-name ${ENVIRONMENT_NAME}
                    """
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                script {
                    // Add your verification steps here
                    // For example, curl your health endpoint:
                    // sh 'curl -s http://your-env.elasticbeanstalk.com/actuator/health'
                    echo "Deployment verification would go here"
                }
            }
        }
    }
    post {
        success {
            echo 'Deployment to Elastic Beanstalk succeeded!'
            // Optional: Notify success (Slack, email, etc.)
        }
        failure {
            echo 'Deployment to Elastic Beanstalk failed!'
            // Optional: Notify failure
        }
    }
}