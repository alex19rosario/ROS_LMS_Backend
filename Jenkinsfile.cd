pipeline {
    agent any

    tools {
        jdk 'jdk-25'
    }

    environment {
        AWS_DEFAULT_REGION = "us-east-1"
        APPLICATION_NAME = "Ros-lms-backend"
        ENVIRONMENT_NAME = "Ros-lms-backend-env-1"
        S3_BUCKET = "ros-lms-backend-deployments"
        JAR_FILE = "target/lms-0.0.1-SNAPSHOT.jar"
    }
    stages {
        stage('Build') {
            steps {
                sh './mvnw clean package -DskipTests'
            }
        }

        stage('Upload JAR to S3') {
            steps {
                withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'aws-credentials', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                    script {
                        def timestamp = new Date().format("yyyyMMddHHmmss", TimeZone.getTimeZone('UTC'))
                        env.VERSION_LABEL = "app-${timestamp}"

                        sh """
                            aws s3 cp ${JAR_FILE} s3://${S3_BUCKET}/${env.VERSION_LABEL}.jar
                        """
                    }
                }
            }
        }

        stage('Deploy to Elastic Beanstalk') {
            steps {
                withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'aws-credentials', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                    sh """
                        # 1. Create version
                        aws elasticbeanstalk create-application-version \
                            --application-name ${APPLICATION_NAME} \
                            --version-label ${env.VERSION_LABEL} \
                            --source-bundle S3Bucket=${S3_BUCKET},S3Key=${env.VERSION_LABEL}.jar

                        # 2. Deploy
                        aws elasticbeanstalk update-environment \
                            --application-name ${APPLICATION_NAME} \
                            --environment-name ${ENVIRONMENT_NAME} \
                            --version-label ${env.VERSION_LABEL}

                        # 3. Wait for deployment to complete
                        echo "Waiting for deployment to finish..."
                        aws elasticbeanstalk wait environment-updated \
                            --application-name ${APPLICATION_NAME} \
                            --environment-name ${ENVIRONMENT_NAME}
                    """
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                script {
                    // Add retry logic and proper health check validation
                    retry(3) {
                        sh 'curl -s http://ros-lms-api.us-east-1.elasticbeanstalk.com/actuator/health'
                    }
                }
            }
        }
    }
    post {
        success {
            echo 'Deployment to Elastic Beanstalk succeeded!'
            // Optional: Notify success (Slack, email, etc.)
        }
        failure {
            echo 'Deployment to Elastic Beanstalk failed!'
            // Optional: Notify failure
        }
    }
}